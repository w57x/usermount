package views

templ Activate(errorMsg string) {
	@Layout("Activate Account") {
		<div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
			<div class="flex justify-center">
				<img src="/assets/usermount.svg" alt="usermount logo"/>
			</div>
			<div class="card p-6 bg-white space-y-4">
				<div class="space-y-1 text-center">
					<h1 class="text-xl font-semibold tracking-tight text-zinc-900">Activate Account</h1>
					<p class="text-xs text-zinc-400 font-normal">Enter the activation code sent to your personal email</p>
				</div>
				if errorMsg != "" {
					<div class="bg-red-50 text-red-700 border border-red-200/60 text-xs p-2.5 rounded-md text-center">
						{ errorMsg }
					</div>
				}
				<form action="/api/activate" method="POST" class="space-y-3">
					<div class="space-y-1">
						<label for="code" class="text-xs font-medium text-zinc-500">Activation Code</label>
						<input type="text" id="code" name="code" required class="input-pure font-mono text-center tracking-widest uppercase text-base" placeholder="XXXX-XXXX-XXXX"/>
					</div>
					<button type="submit" class="btn-pure w-full mt-2 text-xs font-semibold">Verify Activation Code</button>
				</form>
			</div>
			<div class="text-center">
				<a href="/login" class="text-xs text-zinc-500 hover:text-zinc-900 transition-colors">Back to Sign In</a>
			</div>
		</div>
	}
}
