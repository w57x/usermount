package views

templ Home(username string) {
	@Layout("Home") {
		<div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
			<div class="flex justify-center">
				<img src="/assets/usermount.svg" alt="usermount logo"/>
			</div>
			<div class="card p-6 bg-white space-y-6 text-center">
				<div class="space-y-2">
					<div class="mx-auto h-9 w-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100">
						@Lucide("check-circle", "h-5 w-5")
					</div>
					<h1 class="text-lg font-semibold text-zinc-900">Welcome, { username }!</h1>
					<p class="text-xs text-zinc-500 font-normal">Your account has been initialized and is ready.</p>
				</div>
				<div class="pt-4 border-t border-zinc-100">
					<a href="/logout" class="btn-pure-outline w-full text-xs font-semibold">Sign Out</a>
				</div>
			</div>
		</div>
	}
}
