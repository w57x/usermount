package views

// This generates a unique, hashed class name (e.g., "className_1a2b3c")
// to guarantee the CSS is scoped only to elements that use it.
css highlightStyle() {
    background-color: #f0f8ff;
    border: 1px solid #0056b3;
    padding: 10px;
    border-radius: 4px;
}

// A reusable component that takes a slice of strings
templ ItemList(title string, items []string) {
    <div>
        <h2>{ title }</h2>

        // Using a standard Go for-loop
        <ul>
            for _, item := range items {
                <li class={ highlightStyle() }>
                    { item }
                </li>
            }
        </ul>
    </div>
}
